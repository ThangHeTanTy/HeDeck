# Chuẩn hoá ký tự xuống dòng, tránh cả kho mã hiện "đã sửa" khi
# chỉ là khác Windows với Linux.
* text=auto eol=lf

# Script Windows bắt buộc dùng CRLF, dùng LF sẽ chạy sai.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# File nhị phân: đừng đụng vào.
*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.zip binary
